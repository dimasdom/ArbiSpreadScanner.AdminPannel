# ── Build stage ────────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies first (layer cache)
COPY ArbiScannerAdminPanel.Client/package.json ArbiScannerAdminPanel.Client/package-lock.json ./
RUN npm ci --ignore-scripts

# Copy the rest of the client source and build
COPY ArbiScannerAdminPanel.Client/ ./

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

ARG VITE_OIDC_AUTHORITY
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_URI
ENV VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI

# Run Vite directly to skip the tsc type-check step in the npm build script
# --base matches the /admin/ prefix this app is served under behind the gateway nginx
RUN ./node_modules/.bin/vite build --base=/admin/

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM nginx:alpine AS final
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
