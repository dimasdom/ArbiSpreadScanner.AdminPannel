{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "app", "value": "arbiscanner-admin" },
            { "key": "env", "value": "development" }
          ],
          "propertiesAsLabels": [ "level" ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Authority": "https://auth.arbiscannerwebapp.site/realms/arbiscanner-admin",
    "Audience": "arbiscanner-admin-api"
  },
  "Keycloak": {
    "WebRealmAdmin": {
      "Authority": "https://auth.arbiscannerwebapp.site/realms/arbiscanner-web",
      "ClientId": "arbiscanner-web-admin-ops",
      "ClientSecret": ""
    }
  },
  "OxaPay": {
    "BaseUrl": "https://api.oxapay.com/v1",
    "MerchantApiKey": "",
    "DefaultCurrency": "USD",
    "DefaultLifetime": 30,
    "Sandbox": true
  }
}
